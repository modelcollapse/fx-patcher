         "code": "Param size(120);\nParam density(0.6);\nParam pitch(0);\nParam spray(0.3);\nParam position(300);\nParam reverse(0);\nParam width(0.7);\nParam fb(0);\nParam pspray(0);\nData buf(768000, 2);\nHistory w(0);\nHistory fo1(0);\nHistory fo2(0);\nHistory ph0(0.0);\nHistory st0(0);\nHistory rt0(1);\nHistory pn0(0.5);\nHistory on0(1);\nHistory ph1(0.25);\nHistory st1(0);\nHistory rt1(1);\nHistory pn1(0.5);\nHistory on1(1);\nHistory ph2(0.5);\nHistory st2(0);\nHistory rt2(1);\nHistory pn2(0.5);\nHistory on2(1);\nHistory ph3(0.75);\nHistory st3(0);\nHistory rt3(1);\nHistory pn3(0.5);\nHistory on3(1);\nlen = dim(buf);\nS = mstosamps(clamp(size, 10, 1000));\npoke(buf, in1 + fo1 * fb, w, 0);\npoke(buf, in2 + fo2 * fb, w, 1);\nsl = 0;\nsg = 0;\nph0 = ph0 + 1 / S;\nif (ph0 >= 1) {\n    ph0 = ph0 - 1;\n    st0 = w - mstosamps(position) - abs(noise()) * spray * mstosamps(2000) - S * 2;\n    rt0 = pow(2, (pitch + noise() * pspray * 12) / 12) * ((noise() * 0.5 + 0.5) < reverse ? -1 : 1);\n    pn0 = 0.5 + noise() * 0.5 * width;\n    on0 = (noise() * 0.5 + 0.5) < (density + 0.1);\n}\nq0 = st0 + ph0 * S * rt0;\ng0 = sin(pi * ph0) * on0;\nsl = sl + peek(buf, q0, 0, interp=\"linear\", boundmode=\"wrap\") * g0 * (1 - pn0) * 1.2;\nsg = sg + peek(buf, q0, 1, interp=\"linear\", boundmode=\"wrap\") * g0 * pn0 * 1.2;\nph1 = ph1 + 1 / S;\nif (ph1 >= 1) {\n    ph1 = ph1 - 1;\n    st1 = w - mstosamps(position) - abs(noise()) * spray * mstosamps(2000) - S * 2;\n    rt1 = pow(2, (pitch + noise() * pspray * 12) / 12) * ((noise() * 0.5 + 0.5) < reverse ? -1 : 1);\n    pn1 = 0.5 + noise() * 0.5 * width;\n    on1 = (noise() * 0.5 + 0.5) < (density + 0.1);\n}\nq1 = st1 + ph1 * S * rt1;\ng1 = sin(pi * ph1) * on1;\nsl = sl + peek(buf, q1, 0, interp=\"linear\", boundmode=\"wrap\") * g1 * (1 - pn1) * 1.2;\nsg = sg + peek(buf, q1, 1, interp=\"linear\", boundmode=\"wrap\") * g1 * pn1 * 1.2;\nph2 = ph2 + 1 / S;\nif (ph2 >= 1) {\n    ph2 = ph2 - 1;\n    st2 = w - mstosamps(position) - abs(noise()) * spray * mstosamps(2000) - S * 2;\n    rt2 = pow(2, (pitch + noise() * pspray * 12) / 12) * ((noise() * 0.5 + 0.5) < reverse ? -1 : 1);\n    pn2 = 0.5 + noise() * 0.5 * width;\n    on2 = (noise() * 0.5 + 0.5) < (density + 0.1);\n}\nq2 = st2 + ph2 * S * rt2;\ng2 = sin(pi * ph2) * on2;\nsl = sl + peek(buf, q2, 0, interp=\"linear\", boundmode=\"wrap\") * g2 * (1 - pn2) * 1.2;\nsg = sg + peek(buf, q2, 1, interp=\"linear\", boundmode=\"wrap\") * g2 * pn2 * 1.2;\nph3 = ph3 + 1 / S;\nif (ph3 >= 1) {\n    ph3 = ph3 - 1;\n    st3 = w - mstosamps(position) - abs(noise()) * spray * mstosamps(2000) - S * 2;\n    rt3 = pow(2, (pitch + noise() * pspray * 12) / 12) * ((noise() * 0.5 + 0.5) < reverse ? -1 : 1);\n    pn3 = 0.5 + noise() * 0.5 * width;\n    on3 = (noise() * 0.5 + 0.5) < (density + 0.1);\n}\nq3 = st3 + ph3 * S * rt3;\ng3 = sin(pi * ph3) * on3;\nsl = sl + peek(buf, q3, 0, interp=\"linear\", boundmode=\"wrap\") * g3 * (1 - pn3) * 1.2;\nsg = sg + peek(buf, q3, 1, interp=\"linear\", boundmode=\"wrap\") * g3 * pn3 * 1.2;\nw = wrap(w + 1, 0, len);\nfo1 = tanh(sl);\nfo2 = tanh(sg);\nout1 = fo1;\nout2 = fo2;\n",
