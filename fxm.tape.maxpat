          700.0
         ],
         "outlettype": [
          "",
          ""
         ],
         "code": "Param wow(0.3);\nParam flutter(0.2);\nParam age(0.3);\nParam hiss(0.05);\nParam drop(0);\nParam sat(0.3);\nParam tone(0.6);\nParam speed(0.5);\nDelay dl(19200, interp=\"linear\");\nDelay dr(19200, interp=\"linear\");\nHistory n1(0);\nHistory lpl(0);\nHistory lpr(0);\nHistory l2l(0);\nHistory l2r(0);\nHistory dg(1);\nHistory dt(1);\nbase = mstosamps(25);\nsm = 1 - exp(-twopi * 0.5 / samplerate);\nn1 = n1 + sm * (noise() - n1);\nm = wow * 0.5 * (cycle(0.3 + speed * 1.2) + n1) + flutter * 0.08 * cycle(6 + speed * 8);\ndd = base * (1 + m * 0.6);\nxl = dl.read(dd);\nxr = dr.read(dd * 1.002);\ndl.write(in1);\ndr.write(in2);\nif (noise() > 1 - drop * 0.0004) {\n    dt = 1 - drop * 0.9;\n}\ndt = dt + (1 - dt) * 0.00005;\ndg = dg + (dt - dg) * 0.002;\nsg = 1 + sat * 6;\nyl = tanh(xl * sg) / tanh(sg);\nyr = tanh(xr * sg) / tanh(sg);\ncut = clamp(18000 * pow(0.08, age) * (0.4 + tone * 0.6), 200, 18000);\nc = 1 - exp(-twopi * cut / samplerate);\nlpl = lpl + c * (yl - lpl);\nlpr = lpr + c * (yr - lpr);\nl2l = l2l + c * (lpl - l2l);\nl2r = l2r + c * (lpr - l2r);\nout1 = l2l * dg + noise() * hiss * 0.03;\nout2 = l2r * dg + noise() * hiss * 0.03;\n",
         "fontface": 0,
         "fontname": "<Monospaced>",
         "fontsize": 12.0
        }
